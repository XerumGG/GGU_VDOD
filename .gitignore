# GGU_VDOD .gitignore

# Python cache
__pycache__/
*.py[cod]
*.egg-info/

# Per-user application preferences and secrets
settings.json
auth_sessions.json
auth_sessions.dat
.env
*.cookies.txt

# Virtual Environment
venv/

# IDE & Runner Artifacts
.vscode/
.idea/
tempCodeRunnerFile*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
test_dl*/
issues/

# Build output
installer_output/
**/installer_output/
build/
dist/
dist_v*/

# Local FFmpeg / QJS binaries
ffmpeg/
bin/

# yt-dlp partial / fragment downloads
*.part
*.ytdl

# Temporary cookies (DPAPI decryptor output)
temp_cookies/

# OS
.DS_Store
Thumbs.db

# Logs & Temp
*.log
*.AGENTS.md
*.tmp
*.bak

# Zip backups
*.zip

# Download output folder (local to user; never track generated files)
VDOs/
#Dev : XerumGG
